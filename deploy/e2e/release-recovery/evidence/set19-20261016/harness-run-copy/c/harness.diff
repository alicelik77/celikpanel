+# set19 run b: with the stamp aged, systemd moved the missed elapse to the boot time and added the timer's
+# RandomizedDelaySec (up to 12 h); on a guest booted minutes earlier that lands in the future, so the update's timer
+# start did not start the renewal. On a server that has run for days the moved elapse is often already past (the
+# production race). The lab removes the random delay with a timer drop-in written BEFORE the update, so it is part
+# of the timer definition the update captures and must keep.
+TIMER_DROP_IN = "/etc/systemd/system/certbot.timer.d/50-set19-lab-no-random-delay.conf"
+CATCHUP = ("echo '== timer drop-in without the random delay (lab)'; "
+           f"mkdir -p {shlex.quote(str(Path(TIMER_DROP_IN).parent))}; "
+           f"printf '[Timer]\nRandomizedDelaySec=0\n' > {TIMER_DROP_IN}; echo \"timer_drop_in_rc=$?\"; cat {TIMER_DROP_IN}; "
+           "systemctl daemon-reload; echo \"reload_rc=$?\"; "
+           "echo '== age the persistent stamp (lab)'; "
+           f"mkdir -p {shlex.quote(str(Path(STAMP).parent))}; touch -d '3 days ago' {STAMP}; echo \"touch_rc=$?\"; ")
