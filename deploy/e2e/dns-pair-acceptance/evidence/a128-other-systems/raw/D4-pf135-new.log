ii  postfwd        1.35-8       all          Postfix policyd to combine complex restrictions in a ruleset
STARTUP=0
CONF=/etc/postfix/postfwd.cf
INET=127.0.0.1
PORT=10040
RUNAS="postfw"
ARGS="--summary=600 --cache=600 --cache-rdomain-only --cache-no-size"
[Service]
ExecStartPre=+/usr/bin/install -d -o ${RUNAS} -g ${RUNAS} -m 0700 /var/lib/celikpanel-postfwd
ExecStart=
ExecStart=/usr/sbin/postfwd $ARGS --cache=0 --keep_rates --save_rates /var/lib/celikpanel-postfwd/rates --daemon --file $CONF --interface $INET --port $PORT --user $RUNAS --group $RUNAS --pidfile $PIDFILE
active
