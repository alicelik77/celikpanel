celikpanel.conf
# Written by CelikPanel (outgoing mail limits).
# It keeps postfwd's hourly counters across a reload (--keep_rates) and
# turns off the request cache, which answers a repeated request with an
# earlier decision: a lifted pause or a changed limit would wait for it,
# and repeated end-of-message requests would not be counted (--cache=0).
# postfwd 1.x is restarted to take changed rules; it saves its counters
# at its end and loads them at its start (--save_rates).
# Remove this file and run systemctl daemon-reload to return to the
# package's own start line.
[Service]
ExecStartPre=+/usr/bin/install -d -o ${RUNAS} -g ${RUNAS} -m 0700 /var/lib/celikpanel-postfwd
ExecStart=
ExecStart=/usr/sbin/postfwd $ARGS --cache=0 --keep_rates --save_rates /var/lib/celikpanel-postfwd/rates --daemon --file $CONF --interface $INET --port $PORT --user $RUNAS --group $RUNAS --pidfile $PIDFILE
/usr/sbin/postfwd --summary=600 --cache=600 --cache-rdomain-only --cache-no-size --cache=0 --keep_rates --save_rates /var/lib/celikpanel-postfwd/rates --daemon --file /etc/postfix/postfwd.cf --interfa
