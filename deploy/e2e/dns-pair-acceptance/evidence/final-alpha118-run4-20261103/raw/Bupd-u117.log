# Managed by CelikPanel: Dovecot mailbox quotas. sha256=e8b8bfbac0276514de0fccc6c13d463c9563b72d7cb9978489234a986195d444
# Mailbox size limits from /etc/dovecot/users, enforced by Dovecot itself.
# Postfix asks the quota-status service below before it accepts mail, so mail
# to a full mailbox is refused (552) instead of stored. CelikPanel rewrites
# this file only while it is exactly as CelikPanel wrote it. Dovecot runs
# from this file with or without CelikPanel.
# Posta kutusu boyut sınırları; dolu kutuya gelen posta reddedilir.
mail_plugins = $mail_plugins quota
protocol imap {
  mail_plugins = $mail_plugins imap_quota
}
plugin {
  quota = count:User quota
  quota_vsizes = yes
  quota_rule = *:storage=1024M
  quota_status_success = DUNNO
  quota_status_nouser = DUNNO
  quota_status_overquota = "552 5.2.2 Mailbox is full"
  quota_warning = storage=90%% quota-warning warn 90 %u
}
service quota-warning {
  executable = script /usr/local/libexec/celikpanel-quota-warning
  user = vmail
  unix_listener quota-warning {
    user = vmail
  }
}
service quota-status {
  executable = quota-status -p postfix
  unix_listener /var/spool/postfix/private/celikpanel-quota-status {
doveconf rc=0 
check_policy_service { unix:private/celikpanel-quota-status, default_action=DUNNO }
