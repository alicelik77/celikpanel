# 2.4.5 (0cbb641e3e): /etc/dovecot/dovecot.conf
# OS: Linux 7.2.11-arch1-1 x86_64  btrfs
# Hostname: archtwo
dovecot_config_version = 2.4.5
dovecot_storage_version = 2.4.5
first_valid_uid = 5000
mail_driver = maildir
mail_gid = 5000
mail_path = /var/spool/mail/vhosts/%{user | domain}/%{user | username}
mail_uid = 5000
protocols {
  imap = yes
  pop3 = yes
  lmtp = yes
}
namespace inbox {
  inbox = yes
}
ssl_server {
  cert_file = /etc/ssl/celikpanel/_mail/host/current/fullchain.pem
}
service auth {
  unix_listener /var/spool/postfix/private/auth {
    group = postfix
    mode = 0660
    user = postfix
  }
}
  default_password_scheme = CRYPT
}
  fields {
    gid:default = 5000
    home:default = /var/spool/mail/vhosts/%{user | domain}/%{user | username}
    uid:default = 5000
  }
}
