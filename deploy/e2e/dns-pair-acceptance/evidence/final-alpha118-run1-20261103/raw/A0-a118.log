## traffic conf
# celikpanel-render v2 sha256=bdd4154dc606ef1b3d61c783d03634a603f53dd70a142e78ec16711c0b87197e
# CelikPanel's traffic measurement: the log format of the small per-site
# traffic logs in /var/log/celikpanel/traffic. Plain nginx configuration;
# your own logs are not changed. CelikPanel writes this file only while it
# is CelikPanel's unchanged text. Without it the sites keep working and
# their traffic is shown as unknown.
# CelikPanel trafik ölçümü: site başına küçük trafik günlüklerinin biçimi.
log_format celikpanel_traffic '$msec $bytes_sent $request_length';
map $uri $celikpanel_traffic_counted {
    ~^/\.well-known/acme-challenge/ 0;
    default 1;
}
