## logrotate
# celikpanel-render v2 sha256=53038f4c9c6b7b7b2951e1f32c73b84feeb98926d841fae65edd4d447cd208b4
# The small per-site traffic logs nginx writes for CelikPanel's monthly
# traffic limit. Rotated by the operating system, with or without CelikPanel.
# CelikPanel writes this file only while it is CelikPanel's unchanged text.
# CelikPanel'in trafik günlükleri; işletim sistemi döndürür.
/var/log/celikpanel/traffic/*.log {
    daily
    maxsize 100M
    rotate 3
    missingok
    notifempty
    compress
