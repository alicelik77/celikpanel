# /etc/systemd/system/celikpanel-egress-guard.service
# celikpanel-render v2 sha256=4e275793bc8886123f23a4a504075ff61d4e960e04dddaceaf99db0f5a868fca
# CelikPanel site sandbox: keeps the SMTP egress block in place (docs/SITE-SANDBOX.md).
[Unit]
Description=CelikPanel site sandbox SMTP egress guard
After=network-pre.target

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/celikpanel-sandbox/egress-guard.sh
LogLevelMax=notice
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
